{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/renderer/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.json",
    "src/preload/index.d.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "outDir": "node_modules/.cache/tsc/web",
    "tsBuildInfoFile": "node_modules/.cache/tsc/web.tsbuildinfo"
  }
}
